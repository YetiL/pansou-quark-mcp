PANSOU_URL=https://your-pansou-api.example.com
QUARK_COOKIE=YOUR_QUARK_COOKIE_HERE
TMDB_API_KEY=YOUR_TMDB_API_KEY_OR_V4_TOKEN

# 第三方大模型 API（兼容 OpenAI 格式，如 DeepSeek / SiliconFlow / OpenRouter / OneAPI）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-llm-api-key
LLM_MODEL=deepseek-chat

# 接口访问密钥（建议设置，防止被他人调用）
API_SECRET=your-secret-token

# 可选配置
MOVIE_DIR=/影视库/电影
TV_DIR=/影视库/剧集
PREFER_KEYWORDS=4K,2160p,HDR,杜比视界,DoVi,WEB-DL,高码率,HQ,MP4,简繁,内封
EXCLUDE_KEYWORDS=枪版,TC,TS,CAM,HDRip,删减,预告
